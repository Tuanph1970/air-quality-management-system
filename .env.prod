# =============================================================================
# Air Quality Management System — Production Environment
# =============================================================================
# COMMITTED to git. Contains non-sensitive defaults.
# Secrets must be set via:  deploy.sh --prod  OR  GitHub Secrets
# =============================================================================

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database Credentials — SET VIA GITHUB SECRETS or deploy.sh -e flags
# ---------------------------------------------------------------------------
DB_USER=aqms_admin
DB_PASSWORD=acb1a0df7a7585f827de2db6e1ddde092130dede31853e45

# ---------------------------------------------------------------------------
# MySQL (for station-excel-fetcher)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_USER=aqms_rabbitmq
RABBITMQ_PASS=3e839cefdf69ed50554a2c6b5289695abd1336aecdd33be2
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=53ca9ed9e1c1cb2c5e98c8a7c3c8217df2baaa2bb1aea5d6
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# JWT — Generate with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=3c7a31a43258e6647c8eb1ac9e3c95d250536f4a48f8a230b74dbdda8b3f2d10

# ---------------------------------------------------------------------------
# External APIs — SET VIA GITHUB SECRETS
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
COPERNICUS_ADS_API_KEY=
NASA_EARTHDATA_TOKEN=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
PURPLEAIR_API_KEY=

# ---------------------------------------------------------------------------
# City Bounding Box (Hà Nội defaults — adjust as needed)
# ---------------------------------------------------------------------------
CITY_BBOX_NORTH=21.1
CITY_BBOX_SOUTH=20.9
CITY_BBOX_EAST=105.9
CITY_BBOX_WEST=105.7

# ---------------------------------------------------------------------------
# WRF Service
# ---------------------------------------------------------------------------
WRF_NUM_PROCESSES=4
WRF_USE_SAMPLE_DATA=True

# ---------------------------------------------------------------------------
# Station Ingestion Service (dev profile — not started by default)
# ---------------------------------------------------------------------------
STATION_API_BASE_URL=https://admin-qttd.tedp.vn/api/partner/v1
STATION_API_KEY=
STATION_INGESTION_PORT=8010
FETCH_INTERVAL_SECONDS=300
AQI_HOURS_PAGE_SIZE=100
USE_FAKE_DATA=False

# ---------------------------------------------------------------------------
# Station Excel Fetcher (Envisoft data source)
# ---------------------------------------------------------------------------
# HTTP Basic Auth (layer 1 — Envisoft portal)
ENVISOFT_BASIC_USER=tw-admin
ENVISOFT_BASIC_PASS=tw-admin

# Web form login (layer 2 — inside iframe)
ENVISOFT_FORM_USER=duongngocbach
ENVISOFT_FORM_PASS='1234567890!@#$%^&*()'

# Path for raw / processed Excel files (persisted via Docker volume)
RAW_DATA_ROOT=/app/raw_excel_data

# Daily at 00:01 AM — change if needed
FETCH_CRON_EXPRESSION='1 0 * * *'
FETCH_ON_STARTUP=False

# ---------------------------------------------------------------------------
# PurpleAir
# ---------------------------------------------------------------------------
PURPLEAIR_USE_FAKE_DATA=False
PURPLEAIR_FAKE_DATA_INTERVAL=60
PURPLEAIR_SENSORS=[]

# ---------------------------------------------------------------------------
# Station Service
# ---------------------------------------------------------------------------
FAKE_DATA_STATION_COUNT=5
FAKE_DATA_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Frontend (build-time vars start with VITE_)
# ---------------------------------------------------------------------------
VITE_API_URL=/api/v1

# ---------------------------------------------------------------------------
# Data Fusion
# ---------------------------------------------------------------------------
FUSION_INTERVAL_MINUTES=60
CALIBRATION_RETRAIN_DAYS=7
CROSS_VALIDATION_TOLERANCE=0.3

# ---------------------------------------------------------------------------
# Production Build
# ---------------------------------------------------------------------------
IMAGE_TAG=latest
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# SECURITY CHECKLIST before deploying to production
# ---------------------------------------------------------------------------
# [ ] Set MYSQL_ROOT_PASSWORD to a strong value
# [ ] Set DB_PASSWORD to a strong random value
# [ ] Set RABBITMQ_PASS to a strong random value
# [ ] Set REDIS_PASSWORD to a strong random value
# [ ] Generate JWT_SECRET:  openssl rand -hex 32
# [ ] Add real API keys for Google Maps, Copernicus, NASA, Sentinel Hub
# [x] Set ENVISOFT_BASIC_PASS=tw-admin and ENVISOFT_FORM_PASS (pre-filled for station-excel-fetcher)
# [ ] Adjust CITY_BBOX_* to your monitoring region
# [ ] Set WRF_USE_SAMPLE_DATA=False if WRF binaries are mounted
# [ ] Configure SSL/TLS certificates in nginx/ssl/ before enabling 443
# [ ] Review resource limits in docker-compose.prod.yml
# [ ] Set up database backup strategy
# [ ] Review firewall: only ports 80/443 should be publicly exposed
# =============================================================================
